    "COLLISION": {
      "_": "Two muxed channels (Sel0/Sel1) plus an unconditional channel (Uncond) all at the same byte offset: an ambiguous mux that must parse without crashing.",
      "children": {
        "FD": {
          "address": {
            "type": "DMA",
            "offset": "0x1000"
          },
          "numberOfElements": 100,
          "pitch": 8,
          "channels": {
            "Sel0": {
              "selectedBy": {
                "register": "COLLISION.MUX",
                "value": 0
              },
              "bytesPerElement": 2,
              "offset": 0,
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": 0,
                "isSigned": true
              }
            },
            "Sel1": {
              "selectedBy": {
                "register": "COLLISION.MUX",
                "value": 1
              },
              "bytesPerElement": 2,
              "offset": 0,
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": 0,
                "isSigned": true
              }
            },
            "Uncond": {
              "bytesPerElement": 2,
              "offset": 0,
