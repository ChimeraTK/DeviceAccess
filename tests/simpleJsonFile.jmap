{
  "_comment": "Any unknown keys will be ignored. By convention, comments shall use keys starting with an underscore.",
  "_blubb": "This is also a comment",
  "foo": "This is ignored as well, but shouldn't be used for comments",
  "mapFormatVersion": "0.0.1",
  "metadata": {
    "_comment": "Suggested naming convention: camelcase for property names",
    "mapfileRevision": "1.8.3-0-gdeadbeef",
    "someRandomEntry": "some random value"
  },
  "interruptHandler": {
    "0": {
      "INTC": {
        "path": "DAQ",
        "version": 1,
        "_comment": "This is exactly the current JSON snippet from the metadata"
      }
    },
    "3": {
      "INTC": {
        "path": "MY_INTC",
        "options": [
          "MER"
        ],
        "version": 1
      },
      "subhandler": {
        "0": {
          "INTC": {
            "path": "MY_INTC.SUB0",
            "options": []
          }
        },
        "1": {
          "INTC": {
            "path": "MY_INTC.SUB1",
            "options": [
              "MER"
            ]
          }
        }
      }
    }
  },
  "addressSpace": {
    "SomeTopLevelRegister": {
      "engineeringUnit": "mV",
      "description": "This is an example register",
      "access": "RW",
      "cacheable": true,
      "_": "cacheable: Software may assume value never changed from remote side - unused in the beginning. Default: true",
      "numberOfElements": 1,
      "address": {
        "type": "I/O",
        "channel": 0,
        "offset": 32,
        "_comment": "'type' can be 'IO' (default), or 'DMA'. 'channel' is optional and defaults to 0."
      },
      "representation": {
        "type": "fixedPoint",
        "width": 32,
        "fractionalBits": 8,
        "isSigned": true,
        "_comment": "type might be fixedPoint (default), IEEE754, string, or void",
        "validRange": [
          -0.5,
          12.345
        ]
      },
      "initialValue": 3.5,
      "__": "Unclear how to implement, must be written only during initialisation, not upon every open. Maybe remove."
    },
    "BSP": {
      "address": {
        "channel": 0,
        "offset": 0
      },
      "numberOfElements": 19201,
      "bytesPerElement": 4,
      "_comment": "omitting 'representation': width = bytesPerElement * 8 bits, unsigned integer",
      "_comment2": "This is the equivalent of 'ch0_top.BSP', with the BSP.* registers defined as 'children'",
      "children": {
        "VERSION": {
          "access": "RO",
          "numberOfElements": 1,
          "bytesPerElement": 4,
          "address": {
            "offset": 4
          },
          "representation": {
            "type": "fixedPoint",
            "width": 32,
            "fractionalBits": 0,
            "isSigned": false
          },
          "constant": "0x01080300",
          "_comment": "Defining 'constant' value allows to identify/verify firmware version (an type with BSP.PRJ_ID)"
        },
        "SOME_INFO": {
          "access": "RO",
          "numberOfElements": 1,
          "bytesPerElement": 40,
          "address": {
            "channel": 0,
            "offset": 8
          },
          "representation": {
            "type": "string"
          },
          "constant": "0x01080300",
          "_comment": "Defining 'constant' value allows to identify/verify firmware version (an type with BSP.PRJ_ID)"
        },
        "VOID_INTERRUPT_0": {
          "triggeredByInterrupt": [
            0
          ],
          "representation": {
            "type": "void"
          }
        },
        "VOID_INTERRUPT_3_0_1": {
          "triggeredByInterrupt": [
            3,
            0,
            1
          ],
          "representation": {
            "type": "void"
          }
        }
      }
    },
    "APP": {
      "children": {
        "STATUS": {
          "description": "application status",
          "access": "RO",
          "address": {
            "type": "IO",
            "channel": 2,
            "offset": "0x8000"
          },
          "bytesPerElement": 4,
          "children": {
            "ProbeLimiter": {
              "representation": {
                "width": 1
              }
            },
            "ExternalInterlock": {
              "representation": {
                "bitShift": 1,
                "width": 1
              }
            },
            "ErrorCounter": {
              "representation": {
                "bitShift": 2,
                "type": "fixedPoint",
                "width": 3,
                "fractionalBits": 0,
                "isSigned": false
              },
              "_comment": "Will be unsupported at first"
            }
          }
        },
        "LARGE_STATUS": {
          "description": "longer application status",
          "access": "RO",
          "address": {
            "type": "IO",
            "channel": 2,
            "offset": "0x8004"
          },
          "bytesPerElement": 8,
          "representation": {
            "width": 64
          },
          "children": {
            "ProbeLimiter": {
              "representation": {
                "width": 1
              }
            },
            "ExternalInterlock": {
              "representation": {
                "bitShift": 34,
                "width": 1
              }
            },
            "ErrorCounter": {
              "representation": {
                "bitShift": 2,
                "type": "fixedPoint",
                "width": 3,
                "fractionalBits": 0,
                "isSigned": false
              },
              "_comment": "Will be unsupported at first"
            }
          }
        },
        "SomeTable": {
          "access": "WO",
          "numberOfElements": 16384,
          "bytesPerElement": 2,
          "address": {
            "channel": 0,
            "offset": 2048
          },
          "representation": {
            "type": "fixedPoint",
            "width": 14,
            "fractionalBits": 10,
            "isSigned": true
          }
        },
        "SomeFloat": {
          "access": "RW",
          "numberOfElements": 1,
          "bytesPerElement": 4,
          "address": {
            "channel": 0,
            "offset": 4096
          },
          "representation": {
            "type": "IEEE754",
            "width": 32
          }
        }
      }
    },
    "DAQ": {
      "children": {
        "CTRL": {
          "description": "Controller DAQ",
          "triggeredByInterrupt": [
            3,
            0,
            1
          ],
          "_": "^^^ this implies 'access: RO', do not specify both",
          "_comment": "pitch is the number of bytes between two elements in the same channel",
          "address": {
            "type": "DMA",
            "offset": "0x40000"
          },
          "doubleBuffering": {
            "secondaryBufferAddress": {
              "type": "DMA",
              "offset": "0x40200"
            },
            "enableRegister": "DAQ.DOUBLE_BUF.ENA",
            "readBufferRegister": "DAQ.DOUBLE_BUF.INACTIVE_BUF_ID",
            "index": 0,
            "_": "Index inside control registers"
          },
          "__": "The channels below are the layout of this 2D DAQ register. For registers whose layout is selected by a register value (multiple DAQ tabs), a 'selectedBy' dict is added as shown in the FD example below.",
          "numberOfElements": 16384,
          "pitch": 64,
          "channels": {
            "errorI": {
              "bytesPerElement": 2,
              "offset": 0,
              "description": "Error signal in I",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": -2,
                "isSigned": true
              }
            },
            "errorQ": {
              "bytesPerElement": 2,
              "offset": 2,
              "description": "Error signal in Q",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": -2,
                "isSigned": true
              }
            },
            "status": {
              "bytesPerElement": 4,
              "offset": 4,
              "children": {
                "ProbeLimiter": {
                  "representation": {
                    "bitShift": 0,
                    "width": 1
                  }
                },
                "ExternalInterlock": {
                  "representation": {
                    "bitShift": 1,
                    "width": 1
                  }
                },
                "ErrorCounter": {
                  "representation": {
                    "bitShift": 2,
                    "type": "fixedPoint",
                    "width": 3,
                    "fractionalBits": 0,
                    "isSigned": false
                  }
                }
              }
            },
            "VectorSum_I": {
              "bytesPerElement": 4,
              "offset": 8,
              "children": {
                "I": {
                  "representation": {
                    "bitShift": 0,
                    "width": 18
                  }
                }
              }
            },
            "VectorSum_Q": {
              "bytesPerElement": 4,
              "offset": 10,
              "children": {
                "Q": {
                  "representation": {
                    "bitShift": 2,
                    "width": 18
                  }
                }
              }
            }
          }
        },
        "FD": {
          "description": "Field detection DAQ",
          "triggeredByInterrupt": [
            0
          ],
          "address": {
            "type": "DMA",
            "offset": "0x81000"
          },
          "doubleBuffering": {
            "secondaryBufferAddress": {
              "type": "DMA",
              "offset": "0x81200"
            },
            "enableRegister": "DAQ.DOUBLE_BUF.ENA",
            "readBufferRegister": "DAQ.DOUBLE_BUF.INACTIVE_BUF_ID",
            "index": 1
          },
          "_": "Each channel below is active only when the 'selectedBy' register (DAQ.MUX_SEL) equals its 'selectedBy' value.",
          "numberOfElements": 16384,
          "pitch": 64,
          "channels": {
            "AmplitudeCh0": {
              "selectedBy": {
                "register": "DAQ.MUX_SEL",
                "value": 0
              },
              "bytesPerElement": 2,
              "offset": 0,
              "description": "Amplitude of channel 0",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": -2,
                "isSigned": true
              }
            },
            "PhaseCh0": {
              "selectedBy": {
                "register": "DAQ.MUX_SEL",
                "value": 0
              },
              "bytesPerElement": 2,
              "offset": 2,
              "description": "Phase of channel 0",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": -2,
                "isSigned": true
              }
            },
            "RawCh0": {
              "selectedBy": {
                "register": "DAQ.MUX_SEL",
                "value": 1
              },
              "bytesPerElement": 4,
              "offset": 0,
              "description": "Raw signal for channel 0",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 32,
                "fractionalBits": 0,
                "isSigned": true
              }
            },
            "RawCh1": {
              "selectedBy": {
                "register": "DAQ.MUX_SEL",
                "value": 1
              },
              "bytesPerElement": 4,
              "offset": 4,
              "description": "Phase of channel 1",
              "engineeringUnit": "bits",
              "representation": {
                "type": "fixedPoint",
                "width": 32,
                "fractionalBits": 0,
                "isSigned": true
              }
            }
          }
        },
        "SIMPLE2D": {
          "_": "A non-interrupt 2D register with named channels; its slices stay read-only and never advertise wait_for_new_data.",
          "address": {
            "channel": 13,
            "offset": "0x51000"
          },
          "numberOfElements": 4,
          "pitch": 32,
          "channels": {
            "A": {
              "bytesPerElement": 2,
              "offset": 0,
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": 0,
                "isSigned": true
              }
            },
            "B": {
              "bytesPerElement": 2,
              "offset": 2,
              "representation": {
                "type": "fixedPoint",
                "width": 16,
                "fractionalBits": 0,
                "isSigned": true
              }
            }
          }
        },
        "DOUBLE_BUF": {
          "children": {
            "ENA": {
              "bytesPerElement": 4,
              "numberOfElements": 3,
              "address": {
                "channel": 0,
                "offset": 1236
              },
              "representation": {
                "width": 1
              }
            },
            "INACTIVE_BUF_ID": {
              "bytesPerElement": 4,
              "numberOfElements": 3,
              "address": {
                "channel": 0,
                "offset": 1240
              },
              "representation": {
                "width": 1
              }
            }
          }
        },
        "MUX_SEL": {
          "bytesPerElement": 4,
          "numberOfElements": 1,
          "address": {
            "channel": 0,
            "offset": 1244
          },
          "representation": {
            "width": 2
          }
        },
        "SINGLE_MUXED": {
          "_": "A scalar (non-2D) register can carry a register-level 'selectedBy' too: the whole register is only active while DAQ.MUX_SEL equals the 'value'. For scalar/1D registers the selector is given on the register itself (not per channel, which is a 2D concept).",
          "bytesPerElement": 4,
          "numberOfElements": 1,
          "selectedBy": {
            "register": "DAQ.MUX_SEL",
            "value": 0
          },
          "address": {
            "channel": 0,
            "offset": 1246
          },
          "representation": {
            "width": 32
          }
        },
        "SINGLE_MUXED_ALT": {
          "_": "Alternative scalar register for SINGLE_MUXED: muxed alternatives share the same address (offset 1246) and differ only in the 'selectedBy' value (here 1 instead of 0). Only one is active at a time depending on DAQ.MUX_SEL.",
          "bytesPerElement": 4,
          "numberOfElements": 1,
          "selectedBy": {
            "register": "DAQ.MUX_SEL",
            "value": 1
          },
          "address": {
            "channel": 0,
            "offset": 1246
          },
          "representation": {
            "width": 32
          }
        },
        "MACRO_PULSE_NUMBER": {
          "bytesPerElement": 4,
          "numberOfElements": 1,
          "_": "First element of last channel in DAQ.FD area",
          "address": {
            "type": "DMA",
            "offset": "0x8103C"
          },
          "doubleBuffering": {
            "secondaryBufferAddress": {
              "type": "DMA",
              "offset": "0x8123C"
            },
            "enableRegister": "DAQ.DOUBLE_BUF.ENA",
            "readBufferRegister": "DAQ.DOUBLE_BUF.INACTIVE_BUF_ID",
            "index": 1
          },
          "representation": {
            "width": 32
          }
        },
        "ASYNC_DBLBUF": {
          "triggeredByInterrupt": [
            1
          ],
          "bytesPerElement": 4,
          "numberOfElements": 1,
          "address": {
            "type": "DMA",
            "offset": "0x81070"
          },
          "doubleBuffering": {
            "secondaryBufferAddress": {
              "type": "DMA",
              "offset": "0x81270"
            },
            "enableRegister": "DAQ.DOUBLE_BUF.ENA",
            "readBufferRegister": "DAQ.DOUBLE_BUF.INACTIVE_BUF_ID",
            "index": 2
          }
        }
      }
    },
